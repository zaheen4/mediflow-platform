{
  "name": "mediflow-platform",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently \"npm start --prefix backend\" \"npm run dev --prefix frontend\"",
    "dev:backend": "npm start --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "prepare": "husky"
  },
  "lint-staged": {
    "frontend/src/**/*.{js,jsx}": [
      "eslint --fix --config frontend/eslint.config.js",
      "prettier --write --config frontend/.prettierrc"
    ],
    "backend/**/*.js": [
      "eslint --fix --config backend/eslint.config.js",
      "prettier --write --config backend/.prettierrc"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0"
  }
}
